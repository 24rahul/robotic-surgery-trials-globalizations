        <ArticleTitle>Acute peripheral GLP-1 receptor agonism or antagonism does not alter energy expenditure in rats after Roux-en-Y gastric bypass.</ArticleTitle>
        <Pagination>
          <MedlinePgn>70-8</MedlinePgn>
        </Pagination>
        <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.physbeh.2013.03.027</ELocationID>
